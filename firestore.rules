rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile document rules
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    
    // Username registration registry
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false; // Usernames should be deleted and recreated, not updated directly
    }

    // User-specific progress tracker
    match /user_progress/{docId} {
      allow read, write: if request.auth != null && (
        (resource == null && request.resource.data.uid == request.auth.uid) ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
    }

    // User-specific notes
    match /user_notes/{docId} {
      allow write: if request.auth != null && (
        (resource == null && request.resource.data.uid == request.auth.uid) ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.uid == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/shared_notes_access/$(resource.data.uid + "_" + (resource.data.conceptId != null ? resource.data.conceptId : string(resource.data.questionId)) + "_" + request.auth.uid)) &&
          get(/databases/$(database)/documents/shared_notes_access/$(resource.data.uid + "_" + (resource.data.conceptId != null ? resource.data.conceptId : string(resource.data.questionId)) + "_" + request.auth.uid)).data.status == "accepted"
        )
      );
    }

    // Shared notes access records
    match /shared_notes_access/{accessId} {
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.ownerUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid
      );
      allow create: if request.auth != null && 
        request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid
      );
    }

    // User-specific scheduled revisions
    match /user_revisions/{docId} {
      allow read, write: if request.auth != null && (
        (resource == null && request.resource.data.uid == request.auth.uid) ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
    }

    // User-specific custom questions
    match /custom_questions/{docId} {
      allow read, write: if request.auth != null && (
        (resource == null && request.resource.data.uid == request.auth.uid) ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
    }
  }
}
